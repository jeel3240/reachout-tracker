# Copy to web/.env.local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. If set, the site asks for this password once and stores a cookie for 90 days.
# Leave empty for local use.
APP_PASSWORD=
# Optional. Enables the hosted MCP endpoint at /api/mcp. Clients send it as a Bearer token.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=
